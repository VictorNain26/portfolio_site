---
import AskChat from './Ask.tsx';
---

<!-- The assistant is a React island: useChat (@ai-sdk/react) drives the conversation.
     https://ai-sdk.dev/docs/ai-sdk-ui/chatbot -->
<li class="ask-row">
  <AskChat client:visible />
</li>

<script>
  // BotID's invisible challenge, attached to the assistant's requests; /api/ask checks it.
  // https://vercel.com/docs/botid/get-started
  import { initBotId } from 'botid/client/core';

  initBotId({ protect: [{ path: '/api/ask', method: 'POST' }] });
</script>

<!-- Global: Astro scopes styles to its own markup, and the island's markup is React's. -->
<style is:global>
  .ask-row .toggle {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.8rem 0;
    font: inherit;
    font-size: 1.25rem;
    text-align: start;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .ask-row .toggle .count {
    font-size: 1rem;
  }

  /* Unfolds to its content's height: grid rows animate where height: auto cannot. */
  .ask-row .unfold {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }

  .ask-row .unfold.open {
    grid-template-rows: 1fr;
  }

  .ask-row .panel {
    overflow: hidden;
    display: grid;
    gap: 0.75rem;
    padding-bottom: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.45s var(--ease-out),
      padding-bottom 0.5s var(--ease-out);
  }

  .ask-row .open .panel {
    padding-bottom: 1.1rem;
    opacity: 1;
    transform: none;
    transition-delay: 0.12s, 0.12s, 0s;
  }

  .ask-row .hint,
  .ask-row .status,
  .ask-row .reset {
    margin: 0;
    font-size: 1rem;
    color: var(--muted);
  }

  .ask-row .thread {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .ask-row .thread:empty {
    display: none;
  }

  .ask-row .thread .turn {
    display: grid;
    gap: 0.25rem;
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
  }

  .ask-row .thread .turn:first-child {
    border-top: 0;
    padding-top: 0.2rem;
  }

  .ask-row .thread .arrive {
    animation: arrive 0.45s var(--ease-out) both;
  }

  @keyframes arrive {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .ask-row .thread .who {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .ask-row .thread .question {
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .ask-row .thread .answer,
  .ask-row .thread .note {
    margin: 0;
  }

  .ask-row .thread .note {
    margin-top: 0.35rem;
    font-size: 1rem;
    color: var(--muted);
  }

  .ask-row .thread .ink {
    animation: ink 0.28s var(--ease-out) both;
  }

  @keyframes ink {
    from {
      opacity: 0;
    }
  }

  .ask-row .thread .dots {
    display: inline-flex;
    gap: 0.3rem;
    padding-block: 0.5rem;
  }

  .ask-row .thread .dots i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--muted);
    animation: pulse 1.2s ease-in-out infinite;
  }

  .ask-row .thread .dots i:nth-of-type(2) {
    animation-delay: 0.15s;
  }

  .ask-row .thread .dots i:nth-of-type(3) {
    animation-delay: 0.3s;
  }

  @keyframes pulse {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  .ask-row .field {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--muted);
    transition:
      border-color 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out);
  }

  /* Focus thickens the underline to 2px instead of drawing an outline around the bare input. */
  .ask-row .field:focus-within {
    border-bottom-color: var(--fg);
    box-shadow: 0 1px 0 var(--fg);
  }

  .ask-row .field input,
  .ask-row .field button {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    min-height: 2.75rem;
  }

  .ask-row .field input {
    flex: 1;
    min-width: 0;
    padding: 0;
  }

  .ask-row .field input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .ask-row .field input:focus-visible {
    outline: none;
  }

  .ask-row .field button {
    padding-inline: 0.75rem 0;
    cursor: pointer;
    background: linear-gradient(currentColor, currentColor) 100% 85% / 0 1px no-repeat;
    transition: background-size 0.4s var(--ease-out);
  }

  .ask-row .field button:hover {
    background-size: calc(100% - 0.75rem) 1px;
  }

  .ask-row .field input:disabled,
  .ask-row .field button:disabled {
    cursor: not-allowed;
    color: var(--muted);
  }

  .ask-row .meta-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
  }

  .ask-row .status:empty {
    display: none;
  }

  .ask-row .reset {
    padding: 0;
    font: inherit;
    font-size: 1rem;
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--rule);
    transition:
      color 0.3s var(--ease-out),
      text-decoration-color 0.3s var(--ease-out);
  }

  .ask-row .reset:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }

  .ask-row .sources {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 1rem;
  }
</style>
