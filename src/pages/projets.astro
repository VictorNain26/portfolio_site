---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { formatDate } from '../lib/posts';
import { personJsonLd } from '../site';

const projectList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Projets de Victor Lenain',
  numberOfItems: projects.length,
  itemListElement: projects.map((project, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.name,
      description: project.tagline,
      url: project.url,
      keywords: project.stack.join(', '),
      dateModified: project.updatedAt.toISOString().slice(0, 10),
      creator: { '@id': personJsonLd['@id'] },
    },
  })),
};
---

<Base
  title="Projets"
  description="Ce que je bricole pour le plaisir, avec son état réel : en ligne, en pré-lancement ou rangé au placard."
  jsonLd={[projectList]}
>
  <section class="wrap">
    <h1 class="page-title enter">Projets</h1>
    <ul class="rows">
      {projects.map((project, i) => (
        <li class="enter" style={`--i: ${i + 1}`}>
          <a href={project.url} target="_blank" rel="noopener">
            <h2>
              <span class="title-text">{project.name}</span>
              <ArrowUpRight size="0.75em" stroke-width={1.5} />
              <span class="sr-only"> (nouvel onglet)</span>
            </h2>
            {project.tagline && <p>{project.tagline}</p>}
            <p class="meta">
              {project.status} · mis à jour le{' '}
              <time datetime={project.updatedAt.toISOString().slice(0, 10)}>
                {formatDate(project.updatedAt)}
              </time>
            </p>
            {project.stack.length > 0 && <p class="meta">{project.stack.join(', ')}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .rows a {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
  }

  h2 {
    font-size: 1.4rem;
  }

  h2 .lucide {
    color: var(--muted);
    margin-inline-start: 0.15em;
  }
</style>
