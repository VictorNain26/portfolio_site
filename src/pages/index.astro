---
import { getCollection } from 'astro:content';
import Ask from '../components/Ask.astro';
import { projects } from '../data/projects';
import Base from '../layouts/Base.astro';
import { publishedPosts } from '../lib/posts';
import { site } from '../site';

const posts = publishedPosts(await getCollection('posts'), new Date());
const entries = [
  { label: 'Projets', href: '/projets', count: projects.length },
  { label: 'Blog', href: '/blog', count: posts.length },
];
---

<Base header={false}>
  <section class="wrap hero">
    <h1 class="name enter" style="--i: 0">
      {site.name}
    </h1>
    <p class="pitch enter" style="--i: 1">
      Développeur à Paris. Je partage ici ce que je construis sur mon temps libre, surtout autour de
      l'IA, et ce que ça m'apprend.
    </p>
    <nav class="enter" style="--i: 2" aria-label="Sommaire">
      <ul class="rows">
        {entries.map(entry => (
          <li>
            <a href={entry.href}>
              <span class="title-text">{entry.label}</span>
              <span class="count">{entry.count}</span>
            </a>
          </li>
        ))}
        <Ask />
        <li>
          <a href={`mailto:${site.email}`}>
            <span class="title-text">{site.email}</span>
          </a>
        </li>
      </ul>
    </nav>
  </section>
</Base>

<style>
  .hero {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 2rem;
    padding-block: clamp(3rem, 12vh, 7rem) 1rem;
  }

  .name {
    font-size: clamp(2.75rem, 9vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .pitch {
    max-width: 34ch;
    font-size: clamp(1.25rem, 2.4vw, 1.4rem);
    line-height: 1.45;
    color: var(--muted);
  }

  .rows a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.8rem;
    font-size: 1.25rem;
  }

  .title-text {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .count {
    color: var(--muted);
    font-variant-numeric: lining-nums tabular-nums;
  }
</style>
