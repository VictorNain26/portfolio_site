---
import Base from '../layouts/Base.astro';
import { site } from '../site';

let letterIndex = 0;
const words = site.name
  .split(' ')
  .map(word => [...word].map(letter => ({ letter, i: letterIndex++ })));
const entries = [
  { label: 'Projets', href: '/projets', arrow: '→' },
  { label: 'Blog', href: '/blog', arrow: '→' },
  { label: 'Écrire', href: `mailto:${site.email}`, arrow: '↗' },
];
---

<Base header={false}>
  <section class="wrap hero" style={`--letters: ${letterIndex}`}>
    <div class="signature">
      <h1 class="name" aria-label={site.name}>
        {words.map((letters, w) => (
          <>
            {w > 0 && ' '}
            <span class="word">
              {letters.map(({ letter, i }) => (
                <span class="letter" style={`--i: ${i}`}>
                  {letter}
                </span>
              ))}
            </span>
          </>
        ))}
      </h1>
      <svg class="stroke" viewBox="0 0 600 24" preserveAspectRatio="none" aria-hidden="true">
        <path d="M4 15 C 110 5, 250 21, 370 12 S 540 7, 596 13" pathLength="1" />
      </svg>
    </div>
    <p class="pitch">
      Développeur full-stack, et bidouilleur le reste du temps. Ici, je montre ce que je construis
      pour le plaisir, surtout autour de l'IA, et ce que ça m'apprend.
    </p>
    <nav class="index" aria-label="Sommaire">
      <ul>
        {entries.map((entry, i) => (
          <li style={`--i: ${i}`}>
            <a href={entry.href}>
              <span class="label ink">{entry.label}</span>
              <span class="arrow" aria-hidden="true">
                {entry.arrow}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
</Base>

<style>
  /* One sequence: the name inks in letter by letter, the pen underlines it,
     then the rest settles. --letters lets later steps wait for the last letter. */
  .hero {
    --ink-step: 0.045s;
    --after-name: calc(0.35s + var(--letters) * var(--ink-step));
    flex: 1;
    display: grid;
    align-content: center;
    gap: clamp(1.5rem, 4vh, 2.75rem);
    padding-block: clamp(1rem, 3vh, 2rem);
  }

  .signature {
    width: fit-content;
    max-width: 100%;
  }

  .name {
    font-size: clamp(3.5rem, min(13vw, 17vh), 9.5rem);
    line-height: 0.95;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
  }

  .word {
    white-space: nowrap;
  }

  .letter {
    display: inline-block;
    opacity: 0;
    filter: blur(0.12em);
    animation: soak 1.1s var(--ease-out) forwards;
    animation-delay: calc(0.1s + var(--i) * var(--ink-step));
  }

  .stroke {
    display: block;
    width: 100%;
    height: clamp(0.6rem, 1.6vw, 1.1rem);
    margin-top: 0.1em;
    overflow: visible;
  }

  .stroke path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1;
    animation: draw 0.9s var(--ease-pen) forwards;
    animation-delay: var(--after-name);
  }

  .pitch {
    max-width: 38ch;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    color: var(--ink-soft);
    opacity: 0;
    animation: settle 0.9s var(--ease-out) forwards;
    animation-delay: calc(var(--after-name) + 0.35s);
  }

  .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    max-width: 40rem;
  }

  .index li {
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    animation: settle 0.8s var(--ease-out) forwards;
    animation-delay: calc(var(--after-name) + 0.5s + var(--i) * 0.08s);
  }

  .index a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: clamp(0.5rem, 1.2vh, 0.7rem);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
    line-height: 1.2;
  }

  .arrow {
    display: inline-block;
    transition:
      color 0.4s var(--ease-out),
      transform 0.6s var(--ease-out);
  }

  .index a:hover .arrow,
  .index a:focus-visible .arrow {
    color: var(--accent);
    transform: translateX(0.3rem);
  }

  @keyframes soak {
    60% {
      opacity: 1;
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes settle {
    to {
      opacity: 1;
    }
  }
</style>
