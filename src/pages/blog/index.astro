---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, publishedPosts } from '../../lib/posts';
import { personJsonLd, site } from '../../site';

const description =
  'Ce que je retiens de mes projets perso : agents, RAG, serveurs MCP et développement web.';
const posts = publishedPosts(await getCollection('posts'), new Date());

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog de ${site.name}`,
  description,
  url: new URL('/blog', Astro.site).href,
  inLanguage: 'fr-FR',
  author: { '@id': personJsonLd['@id'] },
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(`/blog/${post.id}`, Astro.site).href,
    datePublished: post.data.publishedAt.toISOString(),
  })),
};
---

<Base title="Blog" description={description} jsonLd={[blog]}>
  <section class="wrap">
    <h1 class="page-title">Blog</h1>
    {posts.length === 0 && <p class="summary">Rien pour l'instant, mais ça arrive !</p>}
    <ol class="posts">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id}`}>
            <time class="meta" datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <h2 class="ink">{post.data.title}</h2>
            <p class="summary">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .page-title {
    font-size: clamp(3rem, 9vw, 6rem);
    margin-block: 2rem 3rem;
  }

  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .posts li {
    border-top: 1px solid var(--rule);
  }

  .posts a {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.75rem;
    max-width: var(--measure);
  }

  .posts h2 {
    justify-self: start;
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
  }

  .summary {
    color: var(--ink-soft);
  }
</style>
