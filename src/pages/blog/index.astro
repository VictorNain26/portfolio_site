---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, publishedPosts } from '../../lib/posts';
import { personJsonLd, site } from '../../site';

const posts = publishedPosts(await getCollection('posts'), new Date());

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: site.blog.title,
  description: site.blog.description,
  url: new URL('/blog', Astro.site).href,
  inLanguage: 'fr-FR',
  author: { '@id': personJsonLd['@id'] },
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(`/blog/${post.id}`, Astro.site).href,
    datePublished: post.data.publishedAt.toISOString(),
  })),
};
---

<Base title="Blog" description={site.blog.description} jsonLd={[blog]}>
  <section class="wrap">
    <h1 class="page-title enter">Blog</h1>
    {posts.length === 0 && (
      <p class="summary enter" style="--i: 1">
        Rien pour l'instant, mais ça arrive !
      </p>
    )}
    <ol class="rows">
      {posts.map((post, i) => (
        <li class="enter" style={`--i: ${i + 1}`}>
          <a href={`/blog/${post.id}`}>
            <time class="meta" datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
            <h2>
              <span class="title-text">{post.data.title}</span>
            </h2>
            <p class="summary">{post.data.summary}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .rows a {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.5rem;
  }

  h2 {
    justify-self: start;
    font-size: 1.4rem;
  }

  .summary {
    color: var(--muted);
  }
</style>
