---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, publishedPosts } from '../../lib/posts';
import { personJsonLd, site } from '../../site';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('posts'), new Date());
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/blog/${post.id}`, Astro.site).href;

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: post.data.publishedAt.toISOString(),
  inLanguage: 'fr-FR',
  url,
  mainEntityOfPage: url,
  image: new URL('/og.png', Astro.site).href,
  author: { '@id': personJsonLd['@id'], name: site.name },
  publisher: { '@id': personJsonLd['@id'], name: site.name },
  keywords: post.data.tags.join(', '),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---

<Base
  title={post.data.title}
  description={post.data.summary}
  type="article"
  publishedTime={post.data.publishedAt}
  jsonLd={[blogPosting, breadcrumb]}
  markdown={`${url}.md`}
>
  <article class="wrap article">
    <header class="enter">
      <time class="meta" datetime={post.data.publishedAt.toISOString()}>
        {formatDate(post.data.publishedAt)}
      </time>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose enter" style="--i: 1">
      <Content />
    </div>
    <aside class="contact enter" style="--i: 2" aria-label="Contact">
      <p>
        Une question, une remarque ? Écris-moi à{' '}
        <a class="link" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        .
      </p>
    </aside>
    <p class="back enter" style="--i: 3">
      <a class="link" href="/blog">
        <ArrowLeft size="0.9em" />
        Tous les articles
      </a>
    </p>
  </article>
</Base>

<style>
  .article header {
    display: grid;
    gap: 0.75rem;
    margin-block: 1.5rem 2.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3rem);
  }

  .prose :global(h2) {
    font-size: 1.5rem;
    margin-block: 2.5rem 0.75rem;
  }

  .prose :global(h3) {
    font-size: 1.25rem;
    margin-block: 2rem 0.5rem;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre) {
    margin-block: 0 1.25rem;
  }

  .prose :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--muted);
  }

  .prose :global(a:hover),
  .prose :global(a:focus-visible) {
    text-decoration-color: currentColor;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.25rem;
    border-left: 1px solid var(--fg);
    font-style: italic;
  }

  .prose :global(code) {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.3em;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
  }

  .prose :global(pre) {
    padding: 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--rule);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .prose :global(table) {
    width: 100%;
    margin-block: 0 1.25rem;
    border-collapse: collapse;
    font-size: 1rem;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.45rem 1rem 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: start;
    vertical-align: baseline;
  }

  .prose :global(th) {
    font-weight: 400;
    color: var(--muted);
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin-block: 2.5rem;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  .contact {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .back {
    margin-top: 2rem;
  }

  .back .lucide {
    margin-inline-end: 0.3em;
  }
</style>
