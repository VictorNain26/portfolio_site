---
import Base from '../layouts/Base.astro';
---

<Base title="Page introuvable" noindex>
  <section class="wrap lost">
    <h1>Cette page n'existe pas.</h1>
    <p>
      <a class="link" href="/">
        Revenir à l'accueil
      </a>
    </p>
  </section>
</Base>

<style>
  .lost {
    display: grid;
    gap: 1.5rem;
    padding-block: 6rem;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }
</style>
