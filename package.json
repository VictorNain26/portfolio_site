{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "predev": "node scripts/github.ts --if-missing",
    "dev": "astro dev",
    "prebuild": "node scripts/github.ts",
    "build": "astro build",
    "precheck": "node scripts/github.ts --if-missing",
    "check": "astro check",
    "test": "vitest run --dir src",
    "verify:build": "vitest run --dir tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval": "EVAL_LIVE=1 vitest run --dir evals --no-file-parallelism --silent=false",
    "eval:record": "node evals/record-world.ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "4.0.66",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.15",
    "@langfuse/otel": "5.11.1",
    "@langfuse/tracing": "5.11.1",
    "@langfuse/vercel-ai-sdk": "5.11.1",
    "@lucide/astro": "^1.59.0",
    "@mistralai/mistralai": "2.7.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@shikijs/themes": "^4.4.3",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/functions": "3.10.1",
    "ai": "7.0.143",
    "astro": "^7.4.0",
    "ipaddr.js": "2.5.0",
    "rehype-external-links": "^3.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.29",
    "@astrojs/check": "^0.9.10",
    "@langfuse/client": "5.11.1",
    "cheerio": "^1.2.0",
    "p-throttle": "8.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
