# Copier en .env (jamais commité) et sur Vercel : Settings > Environment Variables,
# pour Production et Preview. Seuls les noms sont ici, jamais les valeurs.

# Clé API Mistral : console Mistral, section API Keys.
MISTRAL_API_KEY=

# Clé HMAC des quotas : Upstash ne voit jamais l'adresse IP d'un visiteur.
# Générer avec : openssl rand -base64 48
VISITOR_SECRET=

# Upstash Redis : quota par visiteur et conversations de suivi. Injectées par
# l'intégration Upstash du Vercel Marketplace ; en local, recopier les deux
# valeurs depuis la console Upstash.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Conseillé partout, nécessaire pour que l'assistant cherche dans le code :
# la recherche de code GitHub exige un jeton, et sans jeton l'API limite à
# 60 requêtes par heure et par IP. Jeton fine-grained, accès en lecture seule
# aux dépôts publics.
GITHUB_TOKEN=

# Langfuse (traces de l'agent et évaluations), projet en région UE :
# Settings > API Keys. Sans ces clés, l'agent tourne sans traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
